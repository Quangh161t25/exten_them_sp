{
  "manifest_version": 3,
  "name": "Shop Spy - Phân tích shop Shopee",
  "short_name": "Shop Spy",
  "description": "Soi shop Shopee: thống kê sản phẩm, đã bán, doanh thu ước tính, top bán chạy, xuất Excel.",
  "version": "1.0.0",
  "icons": { "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["https://shopee.vn/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Shop Spy", "default_popup": "popup.html" }
}
